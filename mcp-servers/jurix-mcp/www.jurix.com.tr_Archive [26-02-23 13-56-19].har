        </div>\n    </div>\n</div>\n\n    <div id=\"comingSoonModal\" class=\"modal fade\">\n    <div class=\"modal-dialog\">\n        <div class=\"modal-content\">\n            <div class=\"modal-body\">\n                <div class=\"form-base\">\n                    <img src=\"/assets/img/logos/logo-color.png\" class=\"logo\" alt=\"\" />\n                    <div class=\"clearfix\"></div>\n                    <h2>Jurix<br>çok yakında hizmetinizde!</h2>\n                    <p>Deneme yayınımızın bitmesine çok az kaldı. Çok yakında binlerce makale sadece bir tık uzakta!</p>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n\n\n    <script data-cfasync=\"false\" src=\"/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js\"></script><script src=\"https://cdnjs.cloudflare.com/ajax/libs/vue-resource/1.0.0/vue-resource.js\"></script>\n    <script src=\"/assets/js/vendor/bootstrap.min.js\"></script>\n    <script src=\"/assets/js/plugins/bootstrap-toolkit/bootstrap-toolkit.js\"></script>\n\n    <!-- menu -->\n    <script src=\"/assets/js/plugins/jquery-menu/jquery.menu-aim.js\"></script> <!-- menu aim -->\n    <script src=\"/assets/js/plugins/jquery-menu/main.js\"></script> <!-- Resource jQuery -->\n\n    <!-- carousel -->\n    <script src=\"/assets/js/plugins/jquery-owl.carousel/owl.carousel.min.js\"></script>\n    <script src=\"/assets/js/core.js\"></script>\n\n    <!-- count-up -->\n    <script src=\"/assets/js/plugins/jquery-counterup/waypoints.min.js\"></script>\n    <script src=\"/assets/js/plugins/jquery-counterup/jquery.counterup.min.js\"></script>\n\n    <!-- pricing-tables -->\n    <script src=\"/assets/js/plugins/jquery-pricing-tables/main.js\"></script>\n\n    <!-- sweet-alert -->\n    <script src=\"/js/sweetalert/dist/sweetalert.min.js\"></script>\n\n    <script src=\"/themenew/global/plugins/slider-revolution-slider/rs-plugin/js/jquery.themepunch.revolution.min.js\"\n        type=\"text/javascript\"></script>\n    <script src=\"/themenew/global/plugins/slider-revolution-slider/rs-plugin/js/jquery.themepunch.tools.min.js\"\n        type=\"text/javascript\"></script>\n    <script src=\"/assets1/js/search_dropdown.js\"></script>\n    <script src=\"/assets/autocomplete/jquery.autocomplete.js\"></script>\n\n    <script type=\"text/javascript\">\n        jQuery(document).ready(function($) {\n                                                                                        $('.counter').counterUp({\n                delay: 10,\n                time: 1000\n            });\n        });\n\n        $('.owl-slider').owlCarousel({\n            loop: true,\n            lazyLoad: true,\n            margin: 0,\n            autoplay: true,\n            autoplaySpeed: 1000,\n            nav: false,\n            responsive: {\n                0: {\n                    items: 1\n                },\n                2000: {\n                    items: 1\n                },\n                4000: {\n                    items: 1\n                }\n            }\n        });\n\n        $('#searchForm').on('submit', function(e) {\n            var searchinput = $('input[name=\"q[]\"]');\n            var queryStringExists = false;\n            var queryStringLength = 0;\n            searchinput.each(function() {\n                var searchValue = $(this).val();\n                if (searchValue) {\n                    queryStringExists = true;\n                    if (searchValue.length > queryStringLength) {\n                        queryStringLength = searchValue.length;\n                    }\n                }\n            });\n            if (!queryStringExists) {\n                swal({\n                    title: \"\",\n                    text: 'Lütfen arama yapmak için bir kelime girin',\n                    html: true,\n                    type: 'error',\n                    confirmButtonColor: '#d7172f',\n                    confirmButtonText: \"Kapat\"\n                });\n                