\n                        templates: {\n                            empty: [\n                                '<div class=\"list-group search-results-dropdown\"><div class=\"list-group-item\">' +\n                                currentScope.trName + ' bulunamadı.</div></div>'\n                            ],\n                            header: [\n                                '<div class=\"list-group search-results-dropdown\">'\n                            ],\n                            suggestion: function(data) {\n                                var sscopeAppend;\n                                var customLink = '';\n                                if (searchScope == 'author' || searchScope == 'keyword') {\n                                    if (searchScope == 'keyword') {\n                                        sscopeAppend = '&sscope=' + searchScope;\n                                        customLink += data.lang + '[]=';\n                                        return '<a href=\"' + currentScope.link +\n                                            customLink + data.id + sscopeAppend +\n                                            '\" class=\"list-group-item\">' + data[currentScope\n                                                .displayField] + '</a>';\n                                    } else {\n                                        sscopeAppend = '&sscope=' + searchScope;\n                                        return '<a href=\"' + currentScope.link +\n                                            customLink + data[currentScope.idField] +\n                                            sscopeAppend + '\" class=\"list-group-item\">' +\n                                            data[currentScope.displayField] + '</a>';\n                                    }\n                                } else {\n                                    sscopeAppend = '?sscope=' + searchScope;\n                                    return '<a href=\"' + currentScope.link + customLink +\n                                        data[currentScope.idField] + sscopeAppend +\n                                        '\" class=\"list-group-item\">' + data[currentScope\n                                            .displayField] + '</a>';\n                                }\n                            }\n                        }\n                    });\n                }\n            });\n        });\n\n    </script>\n\n<script defer src=\"https://static.cloudflareinsights.com/beacon.min.js/vcd15cbe7772f49c399c6a5babf22c1241717689176015\" integrity=\"sha512-ZpsOmlRQV6y907TI0dKBHq9Md29nnaEIPlkf84rnaERnq6zvWvPUqr2ft8M1aS28oN72PdrCzSjY4U6VaAw1EQ==\" data-cf-beacon='{\"version\":\"2024.11.0\",\"token\":\"6d54b8e9829c45fb9aef2c43c8e92a93\",\"server_timing\":{\"name\":{\"cfCacheStatus\":true,\"cfEdge\":true,\"cfExtPri\":true,\"cfL4\":true,\"cfOrigin\":true,\"cfSpeedBrain\":true},\"location_startswith\":null}}' crossorigin=\"anonymous\"></script>\n</body>\n\n</html>\n"
