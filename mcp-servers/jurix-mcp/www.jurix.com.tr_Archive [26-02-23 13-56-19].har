/sup>/g, '');\n                var exists = $('#articleTOC li:contains('+htmlcontent+')').length;\n                if (!exists) {\n                    $('#articleTOC').append('<li class=\"'+$(this).prop(\"tagName\")+'\"><div class=\"articleTOCLine\"><a class=\"headingLink\" href=\"#'+$(this).attr('id')+'\">'+htmlcontent+'</a></div></li>');\n                }\n            });\n\n            $('.articleTOCLine').dotdotdot({\n                ellipsis    : '... ',\n                wrap        : 'word',\n                fallbackToLetter: true,\n                after       : null,\n                watch       : false,\n                height      : null,\n                tolerance   : 0\n            });\n\n            $('.disable-selection .summary').hide();\n            $('.disable-selection .keywords').hide();\n                        var authors = $('h1.author');\n            var currentAuthor = authors[0];\n            $(currentAuthor).replaceWith('<a href=\"/donsearch?author[]=932729258\"><h1 class=\"author\">'+$(currentAuthor).html()+'</a></h1>');\n            \n            if ( 'authorized' == 'authorized') {\n                var lastauthor = $('.disable-selection h1.author').last();\n            } else {\n                var lastauthor = $('#articleTeaser h1.author').last();\n            }\n            \n            $('<div class=\"tabbable summary_keywords_pane\"> \\\n                <ul class=\"nav nav-tabs\" id=\"myTabs2\">  \\\n                    <li class=\"active\"><a href=\"#keywords_tr\" data-toggle=\"tab\">Anahtar Kelimeler</a></li> \\\n                                    </ul> \\\n                <div class=\"tab-content\"> \\\n                    <div class=\"tab-pane active\" id=\"keywords_tr\"> \\\n                     \\\n                    </div> \\\n                                    </div> \\\n               </div>').insertAfter('div.tabbable');\n\n            $('<hr>').insertAfter($('.tabbable'));\n\n            $('.footnote').first().before($('<h1>').text(\"Dipnotlar\"));\n\n\n//            $('#toggleArticleTOC').on('click', function(e) {\n//                e.preventDefault();\n//                $('#articleTOC').toggle();\n//            });\n\n      \n        });\n    </script>\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/vue/1.0.28/vue.min.js\"></script>\n    <script src=\"/js/m38917a2d2ac50.js?1771844136\"></script>\n    <script src=\"/js/typeahead.bundle.js\"></script>\n    <script src=\"/assets/js/plugins/jquery-select/jquery.nice-select.min.js\"></script>\n    <script>\n        $(document).ready(function() {\n            $('footer, .footer-membership').css('display', 'block');\n\n            $('#searchOptions').niceSelect();\n            $('#searchOptionsMobile').niceSelect();\n\n            $('.searchMenuButton').on('click', function() {\n                if ($('.mobileSearch').hasClass('searchShown')) {\n                    $('.mobileSearch').removeClass('searchShown');\n                    $('.slider').removeClass('no-margin');\n                } else {\n                    $('.mobileSearch').addClass('searchShown');\n                    $('.slider').addClass('no-margin');\n                }\n            });\n\n            var scopes = {\n                tasAuthor: {\n                    trName: 'Yazar',\n                    displayField: 'person_full_name',\n                    idField: 'person_idx',\n                    link: '/donsearch?author[]='\n                },\n                tasTitle: {\n                    trName: 'Makale',\n                    displayField: 'title',\n                    idField: 'id',\n                    link: '/article/'\n                },\n                tasKeyword: {\n                    trName: 'Anahtar Kelime',\n                    displayField: 'keyword',\n                    idField: 'id',\n                    link: '/donsearch?'\n                }\n            };\n\n\n            function getBloodHound(displayField, searchScope) {\n                return new Bloodhound({\n                    datumTokenizer: Bloodhound.tokenizers.obj.whitespace(displayField, 'asc'),\n                    queryTokenizer: Bloodhound.tokenizers.whitespace,\n                    remote: {\n                        url: '/tasearch/' + searchScope + '?q=%QUERY',\n                        wildcard: '%QUERY'\n                    }\n                });\n            }\n\n            function getScopeName(scope) {\n                var firstLetter = scope.substr(0, 1);\n                return firstLetter.toUpperCase() + scope.substr(1);\n            }\n\n            var selectedSearchOption = $('#searchOptions').val();\n            if (selectedSearchOption != 'all') {\n                $('#searchOptions').change();\n            }\n\n            $('#searchOptions').on('change', function() {\n\n                $('#searchForm input[name=scope]').remove();\n\n                $('#custom-search-input .input-group input').typeahead('destroy');\n\n                var searchScope = $(this).val();\n\n                if (searchScope != 'all' && searchScope != 'content') {\n\n                    var currentScope = scopes['tas' + getScopeName(searchScope)];\n                    scopes['tas' + getScopeName(searchScope)].func = getBloodHound(scopes['tas' +\n                        getScopeName(searchScope)].displayField, searchScope);\n\n                    $('#custom-search-input .input-group input').typeahead({\n                        hint: false,\n                        highlight: true,\n                        minLength: 3\n                    }, {\n                        classNames: {\n                            input: 'main-search'\n                        },\n                        limit: 100,\n                        display: currentScope.displayField,\n                        source: currentScope.func.ttAdapter(),\n                        templates: {\n                            empty: [\n                                '<div class=\"list-group search-results-dropdown\"><div class=\"list-group-item\">' +\n                                currentScope.trName + ' bulunamadı.</div></div>'\n                            ],\n                            header: [\n                                '<div class=\"list-group search-results-dropdown\">'\n                            ],\n                            suggestion: function(data) {\n                                var sscopeAppend;\n                                var customLink = '';\n                                if (searchScope == 'author' || searchScope == 'keyword') {\n                                    if (searchScope == 'keyword') {\n                                        sscopeAppend = '&sscope=' + searchScope;\n                                        customLink += data.lang + '[]=';\n                                        return '<a href=\"' + currentScope.link +\n                                            customLink + data.id + sscopeAppend +\n                                            '\" class=\"list-group-item\">' + data[currentScope\n                                                .displayField] + '</a>';\n                                    } else {\n                                        sscopeAppend = '&sscope=' + searchScope;\n                                        return '<a href=\"' + currentScope.link +\n                                            customLink + data[currentScope.idField] +\n                                            sscopeAppend + '\" class=\"list-group-item\">' +\n                                            data[currentScope.displayField] + '</a>';\n                                    }\n                                } else {\n                                    sscopeAppend = '?sscope=' + searchScope;\n                                    return '<a href=\"' + currentScope.link + customLink +\n                                        data[currentScope.idField] + sscopeAppend +\n                                        '\" class=\"list-group-item\">' + data[currentScope\n                                            .displayField] + '</a>';\n                                }\n                            }\n                        }\n                    });\n                }\n            });\n        });\n\n    </script>\n\n<script defer src=\"https://static.cloudflareinsights.com/beacon.min.js/vcd15cbe7772f49c399c6a5babf22c1241717689176015\" integrity=\"sha512-ZpsOmlRQV6y907TI0dKBHq9Md29nnaEIPlkf84rnaERnq6zvWvPUqr2ft8M1aS28oN72PdrCzSjY4U6VaAw1EQ==\" data-cf-beacon='{\"version\":\"2024.11.0\",\"token\":\"6d54b8e9829c45fb9aef2c43c8e92a93\",\"server_timing\":{\"name\":{\"cfCacheStatus\":true,\"cfEdge\":true,\"cfExtPri\":true,\"cfL4\":true,\"cfOrigin\":true,\"cfSpeedBrain\":true},\"location_startswith\":null}}' crossorigin=\"anonymous\"></script>\n</body>\n\n</html>\n"
