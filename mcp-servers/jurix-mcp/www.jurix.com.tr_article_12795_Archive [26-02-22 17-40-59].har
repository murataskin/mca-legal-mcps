  items: 1\n                },\n                4000: {\n                    items: 1\n                }\n            }\n        });\n\n        $('#searchForm').on('submit', function(e) {\n            var searchinput = $('input[name=\"q[]\"]');\n            var queryStringExists = false;\n            var queryStringLength = 0;\n            searchinput.each(function() {\n                var searchValue = $(this).val();\n                if (searchValue) {\n                    queryStringExists = true;\n                    if (searchValue.length > queryStringLength) {\n                        queryStringLength = searchValue.length;\n                    }\n                }\n            });\n            if (!queryStringExists) {\n                swal({\n                    title: \"\",\n                    text: 'Lütfen arama yapmak için bir kelime girin',\n                    html: true,\n                    type: 'error',\n                    confirmButtonColor: '#d7172f',\n                    confirmButtonText: \"Kapat\"\n                });\n                e.preventDefault();\n            } else if (queryStringLength < 3) {\n                swal({\n                    title: \"\",\n                    text: 'Lütfen arama yapmak için en az 3 harfli bir kelime girin',\n                    html: true,\n                    type: 'error',\n                    confirmButtonColor: '#d7172f',\n                    confirmButtonText: \"Kapat\"\n                });\n                e.preventDefault();\n            }\n        });\n\n        $('#newsletterSubmitBtn').on('click', function(e) {\n            e.preventDefault();\n            swal({\n                title: \"Haber bültenine abone ol\",\n                text: \"Jurix'teki en son yeniliklerden haberdar olmak için 'Evet' butonuna tıklayın.\",\n                type: \"info\",\n                customClass: \"seckinAlert\",\n                showCancelButton: true,\n                confirmButtonText: \"Evet\",\n                confirmButtonColor: '#d7172f',\n                cancelButtonText: \"Hayır\",\n                closeOnConfirm: false,\n                showLoaderOnConfirm: true,\n            }, function(isConfirm) {\n                if (!isConfirm) return;\n                $.ajax({\n                    'method': 'POST',\n                    'url': '/subscribenl',\n                    'dataType': 'json',\n                    'data': {\n                        '_token': \"X9SwPSRZBtmh6oYlkgNVIsoLc0tpuLYyjhzDhKWx\",\n                        'email': $('[name=\"email\"]').val()\n                    },\n                    'success': function(data) {\n                        swal({\n                            title: 'İşlem tamamlandı!',\n                            text: data.message,\n                            type: 'success',\n                            confirmButtonText: \"Kapat\"\n                        });\n                    },\n                    'error': function(data) {\n                        var errorText = '';\n                        $.each(data.responseJSON.email, function(k, v) {\n                            errorText += '<li>' + v + '</li>';\n                        });\n                        swal({\n                            title: 'İşlem başarısız oldu!',\n                            text: errorText,\n                            html: true,\n                            type: 'error',\n                            confirmButtonText: \"Kapat\"\n                        });\n                    }\n                });\n            });\n        });\n\n        $(document).mouseup(function(e) {\n            var container = $(\"header\");\n            var row = $(\"#searchRow\");\n            if (!container.is(e.target) && container.has(e.target).length === 0) {\n                if (row.is(':visible')) {\n                    row.slideToggle(300, function() {});\n                    $('#magn').removeClass('fa-search-minus').addClass('fa-search');\n                }\n            }\n        });\n\n        var yazar_list_loaded = false;\n        $(document).ready(function() {\n\n            $(\"#yazar_getir\").on(\"click\", function() {\n\n                if (!yazar_list_loaded) {\n                    yazar_list_loaded = true;\n                    $(\"#yazar_getir\").autocomplete({\n\n                        source: [\n                            // states\n                            // preload data from local server\n                            // {\n                            // url:\"/?task=demodata&q=will\",\n                            // type:'remote'\n                            // },\n\n                            // dinamic request from remote \n                            // server through JSONP\n                            {\n                                url: \"/yazar_listesi\",\n                                type: 'remote',\n\n                            }\n                        ]\n                    });\n                }\n\n            })\n\n\n\n            // document.getElementsByName(\"id_no\").onclick = function(tcno){\n            //     console.log(tcno);\n\n            // }\n\n            $(\"input[name='billing_tax_no']\").on('keyup', (event) => {\n\n                var billing_no = event.target.value;\n\n                var billing_no_length = billing_no.length;\n\n                if (billing_no_length > 10) {\n                    $(\"input[name='billing_tax_no']\").val('');\n                }\n            });\n\n            $(\"input[name='id_no']\").on('keyup', (event) => {\n\n                var tcno = event.target.value;\n\n                var tcno_length = tcno.length;\n\n                if (tcno_length === 11) {\n\n                    var tckontrol = tcno;\n\n                    var toplam, toplaminbirlerbasamagi;\n\n                    toplam = Number(tcno.substring(0, 1)) + Number(tcno.substring(1, 2)) +\n                        Number(tcno.substring(2, 3)) + Number(tcno.substring(3, 4)) +\n                        Number(tcno.substring(4, 5)) + Number(tcno.substring(5, 6)) +\n                        Number(tcno.substring(6, 7)) + Number(tcno.substring(7, 8)) +\n                        Number(tcno.substring(8, 9)) + Number(tcno.substring(9, 10));\n                    strtoplam = String(toplam);\n                    toplaminbirlerbasamagi = strtoplam.substring(strtoplam.length, strtoplam.length -\n                    1);\n\n                    if (toplaminbirlerbasamagi == tcno.substring(10, 11)) {\n                        $(\"input[name='id_no']\").placeholder = 'Hatalı giriş yaptınız ...';\n                    } else {\n                        $(\"input[name='id_no']\").val('');\n                    }\n                }\n\n                if (tcno.length > 11) {\n                    $(\"input[name='id_no']\").val('');\n                }\n            });\n\n            var full_url = window.location.href;\n\n            // console.log(full_url.indexOf('subscription'));\n\n            if (full_url.indexOf('subscription') > 0) {\n\n                [...document.querySelectorAll('div.form-group div.col-md-12 div.row div.col-md-4 label')][0]\n                .innerHTML = 'kişi yada şahıs firması';\n                [...document.querySelectorAll('div.form-group div.col-md-12 div.row div.col-md-4')][2].className\n                    = 'col-md-3';\n                [...document.querySelectorAll('div.form-group div.col-md-12 div.row div.col-md-4')][1].className\n                    = 'col-md-3';\n                [...document.querySelectorAll('div.form-group div.col-md-12 div.row div.col-md-4')][0].className\n                    = 'col-md-6';\n\n            }\n\n\n        });\n\n        $(\"#subscriptionFormWrapper\").on(\"keypress\", function(event) {\n            // console.log(\"olmaz\"); \n            var keyPressed = event.keyCode || event.which;\n            if (keyPressed === 13) {\n                // alert(\"You pressed the Enter key!!\"); \n                event.preventDefault();\n                return false;\n            }\n        });\n\n    </script>\n        <script src=\"/scripts/jquery.dotdotdot.min.js\"></script>\n    <script src=\"/theme/global/plugins/moment.min.js\"></script>\n    <script>\n        jQuery(function($) {\n\n        const articleList = document.getElementById('article-list');\n        const articleListPagination = document.getElementById('article-list-pagination');\n        let page = \"197\" - 1;\n            \n            function getPageId(n) {\n                return 'article-page-' + n;\n            }\n\n            function getDocumentHeight() {\n                const body = document.body;\n                const html = document.documentElement;\n\n                return Math.max(\n                    body.scrollHeight, body.offsetHeight,\n                    html.clientHeight, html.scrollHeight, html.offsetHeight\n                );\n            };\n\n            function getScrollTop() {\n                return (window.pageYOffset !== undefined) ? window.pageYOffset : (document.documentElement || document.body.parentNode || document.body).scrollTop;\n            }\n\n            function getArticleImage(page) {\n                                    $('.loadingPage').show();\n                    const hash = Math.floor(Math.random() * Number.MAX_SAFE_INTEGER);\n                    const image = new Image;\n                    image.className = 'article-list__item__image article-list__item__image--loading';\n                    image.src = '/getpageimage/'+page+'/91e5a1b7305af595d4e1b7c2394ac630';\n\n                    image.onload = function() {\n                        image.classList.remove('article-list__item__image--loading');\n                        $('.loadingPage').hide();\n                    };\n\n                    return image;\n                            }\n\n            function getArticle(page) {\n                const articleImage = getArticleImage(page);\n                const article = document.createElement('article');\n                article.className = 'article-list__item';\n                article.appendChild(articleImage);\n\n                return article;\n            }\n\n            function getArticlePage(page, articlesPerPage) {\n                const pageElement = document.createElement('div');\n                pageElement.id = getPageId(page);\n                pageElement.className = 'article-list__page';\n\n                while (articlesPerPage--) {\n                    pageElement.appendChild(getArticle(page));\n                }\n\n                return pageElement;\n            }\n\n            function addPaginationPage(page) {\n                const pageLink = document.createElement('a');\n                pageLink.href = '#' + getPageId(page + 197 - 1);\n                pageLink.innerHTML = page;\n\n                const listItem = document.createElement('li');\n                listItem.className = 'article-list__pagination__item';\n                listItem.appendChild(pageLink);\n\n                articleListPagination.appendChild(listItem);\n\n                if (page === 2) {\n                    articleListPagination.classList.remove('article-list__pagination--inactive');\n                }\n            }\n\n            function fetchPage(page) {\n                articleList.appendChild(getArticlePage(page, 1));\n            }\n\n            function addPage(page) {\n                fetchPage(page);\n                addPaginationPage(page - 197 + 1);\n            }\n\n     \n\n            // addPage(++page);\n            // addPage(++page);\n\n            \n                //window.onscroll = function() {\n                //if (page < 243) {\n                //    $('footer').hide();\n                //}\n                //if (getScrollTop() < getDocumentHeight() - window.innerHeight) return;\n                //if (page < 243) {\n                //    addPage(++page);\n                //    if (page+1 <= 243) {\n                //        addPage(++page);\n                //    }\n                //}\n                //if (page+1 >= 243) {\n                //    $('footer').show();\n                //}\n                //return;\n                // };\n                \n                    });\n    </script>\n            <script type=\"text/javascript\">\n            // This script for tracking Printed Pages & Print Method in Google Analytics is provided as it is, and was put together by Eivind Savio April 2013. You need jQuery for this script to work. Happy tracking!\n            (function () {\n                var runOnce;\n                var afterPrint = function() {\n                    if (!runOnce) { // Because of Chrome we can only allow the code to run once.\n                        runOnce = true;\n                        var printData = $('html').attr('printType');\n                        var mouseButton = $('html').attr('mouseBtn');\n                        if (printData === undefined && mouseButton === 'Right') { // Print activated using Right Mouse Button\n                            printData = 'Right Mouse Button';\n                        } else if (printData === undefined) { // Print (probably) activated using Browser Menu\n                            printData = 'Browser Menu';\n                        }\n\n                        $.ajax({\n                            type: 'POST',\n                            dataType: 'json',\n                            url: '/logprint',\n                            data: {\n                                \"_token\": \"X9SwPSRZBtmh6oYlkgNVIsoLc0tpuLYyjhzDhKWx\",\n                                \"article_id\": \"12795\",\n                                \"user_id\": \"240396\",\n                            },\n                            encode: true\n                        });\n\n                        $('html').removeAttr('printType'); // Clear the attribute, if not printing from the menu can be tracked wrongly.\n                        $('html').removeAttr('mouseBtn'); // Clear the attribute, if not printing from the menu can be tracked wrongly.\n                    };\n                };\n                if (window.matchMedia) { // Track printing from browsers using the Webkit engine\n                    var mediaQueryList = window.matchMedia('print');\n                    mediaQueryList.addListener(function(mql) {\n                        if (!mql.matches) {\n                            afterPrint();\n                        }\n                    });\n                }\n                window.onafterprint = afterPrint; // Internet Explorer\n                $(document).keydown(function(allBrowsers){ // Track printing using Ctrl/Cmd+P.\n                    if (allBrowsers.keyCode==80 && (allBrowsers.ctrlKey || allBrowsers.metaKey)) {\n                        $('html').attr('printType', 'Ctrl/Cmd+P');\n                        if ($.browser.opera) { // Opera is a little different so we must send the afterPrint() function to get the tracking to work.\n                            afterPrint();\n                        }\n                    }\n                });\n                // Detect Right Mouse Button Click\n                $('html').mousedown(function(e) {\n                    if( e.which == 3 ) {\n                        $('html').attr('mouseBtn', 'Right');\n                    }\n                });\n                // Print activated using window.print() ex. from a button. If you don't have a print button on your page, you can remove this code.\n                $('.printMe').click(function(){ // Change this to fit your Class or ID.\n                    $('html').attr('printType', 'Print Button'); // Track printing using Print Button\n                    if ($.browser.opera) { // Opera is a little different so we must send the afterPrint() function to get the tracking to work.\n                        afterPrint();\n                    }\n                    window.print(); // If window.print() is activated in another script, you can remove it from this tracking script.\n                });\n            }());\n        </script>\n        <script>\n        // check if it's open\n        //console.log('is DevTools open?', window.devtools.open);\n        // check it's orientation, null if not open\n        //console.log('and DevTools orientation?', window.devtools.orientation);\n\n        // get notified when it's opened/closed or orientation changes\n        //window.addEventListener('devtoolschange', function (e) {\n        //    $('.disable-selection').toggle();\n        //    console.log('is DevTools open?', e.detail.open);\n        //    console.log('and DevTools orientation?', e.detail.orientation);\n        //});\n    </script>\n    <script>\n        \n        $('footer').show();\n\n        var loadedTime = moment().format('YYYY-MM-DD HH:mm:ss');\n\n        if ('authorized' == 'authorized') {\n                        var printName = \"OGayEj yaOtyk\";\n            var appendString = '<hr><p>'+printName+' iÃ§in yazdÄ±rÄ±lmÄ±ÅŸtÄ±r.</p><p>Belirtilen kiÅŸi haricinde kullanÄ±mÄ±, daÄŸÄ±tÄ±mÄ± ve Ã§oÄŸaltÄ±lmasÄ± 5846 sayÄ±lÄ± Fikir ve Sanat Eserleri Kanunu uyarÄ±nca yasaktÄ±r.</p><hr>';\n            $('#printSec h1.author').after(appendString);\n            $('#printSec li.footnote:first').before(appendString);\n            \n                                                        $(window).on('beforeunload', function() {\n                    var leaveTime = moment().format('YYYY-MM-DD HH:mm:ss');\n                    $.ajax({\n                        async: false,\n                        type: 'POST',\n                        dataType: 'json',\n                        url: '/timetest',\n                        data: {\n                            \"_token\": \"X9SwPSRZBtmh6oYlkgNVIsoLc0tpuLYyjhzDhKWx\",\n                            \"article_id\": 12795,\n                            \"user_id\": \"240396\",\n                            \"loadTime\": loadedTime,\n                            \"unloadTime\": leaveTime,\n                        },\n                        encode: true\n                    });\n                });\n                                    }\n\n\n    </script>\n\n\n    <script>\n\n\n\n\n        $(document).ready(function() {\n\n\n            $('.mostReadTitle').dotdotdot({\n                ellipsis    : '... ',\n                wrap        : 'word',\n                fallbackToLetter: true,\n                after       : null,\n                watch       : false,\n                height      : null,\n                tolerance   : 0\n            });\n\n            var h1count = 0;\n            var h2count = 0;\n            $('h1.seckin, h2.seckin').each(function() {\n                if ($(this).prop(\"tagName\") == 'H1') {\n                    h1count++;\n                    $(this).attr('id', 'h1'+h1count);\n                } else if ($(this).prop(\"tagName\") == 'H2') {\n                    h2count++;\n                    $(this).attr('id', 'h2'+h2count);\n                }\n                var htmlcontent = $(this).html().replace(/<sup>\\d+<\\/sup>/g, '');\n                var exists = $('#articleTOC li:contains('+htmlcontent+')').length;\n                if (!exists) {\n                    $('#articleTOC').append('<li class=\"'+$(this).prop(\"tagName\")+'\"><div class=\"articleTOCLine\"><a class=\"headingLink\" href=\"#'+$(this).attr('id')+'\">'+htmlcontent+'</a></div></li>');\n                }\n            });\n\n            $('.articleTOCLine').dotdotdot({\n                ellipsis    : '... ',\n                wrap        : 'word',\n                fallbackToLetter: true,\n                after       : null,\n                watch       : false,\n                height      : null,\n                tolerance   : 0\n            });\n\n            $('.disable-selection .summary').hide();\n            $('.disable-selection .keywords').hide();\n                        var authors = $('h1.author');\n            var currentAuthor = authors[0];\n            $(currentAuthor).replaceWith('<a href=\"/donsearch?author[]=746212155\"><h1 class=\"author\">'+$(currentAuthor).html()+'</a></h1>');\n                        var authors = $('h1.author');\n            var currentAuthor = authors[1];\n            $(currentAuthor).replaceWith('<a href=\"/donsearch?author[]=853393363\"><h1 class=\"author\">'+$(currentAuthor).html()+'</a></h1>');\n            \n            if ( 'authorized' == 'authorized') {\n                var lastauthor = $('.disable-selection h1.author').last();\n            } else {\n                var lastauthor = $('#articleTeaser h1.author').last();\n            }\n                        lastauthor.after('<div class=\"tabbable summary_keywords_pane\"> \\\n                <ul class=\"nav nav-tabs\" id=\"myTabs\">  \\\n                    <li class=\"active\"><a href=\"#summary_tr\" data-toggle=\"tab\">Ã–zet</a></li> \\\n                                    <li> \\\n                    <a href=\"#summary_other\" data-toggle=\"tab\"> \\\n                Abstract \\\n                </a></li> \\\n                </ul> \\\n                <div class=\"tab-content\"> \\\n                    <div class=\"tab-pane active\" id=\"summary_tr\">Hukuk, bir iyilik ve hakkaniyet sanatıysa; insanlar arasında adaletin en iyi şekilde gerçekleşmesi gerektiğini amaçlamayan bir hukuk sisteminde hukuktan bahsetmek imkânsızsa, hukuku özüne, yani adalet ve hakkaniyete döndürecek hukukçulara ihtiyaç duyulduğuna olan inançtan yola çıkarak hukuk eğitimi yeniden ele alınmalıdır. Özellikle, ülkemizde hukuk eğitimi alanında meydana gelen son değişiklikler ve yenilikler dikkate alınırsa, hukuk eğitimi alanında derin ve köklü bir reforma gidilmesinin zorunlu olduğu ifade edilmelidir. Bu noktada, hukuk fakültesi kontenjanlarının artırılması, neredeyse her üniversite bünyesinde yeni hukuk fakültelerinin kurulması isabetli olmamıştır. Kontenjan artırımı ve öğrenci kabulünde taban puanların düşmesi, göreceli de olsa hukuk eğitimi için yeterli donanıma sahip olmayan öğrencilerin hukuk fakültesine kabulü anlamını taşımaktadır. Fiziksel alt yapı yetersizliği ile kurulan bu yeni fakültelerde ciddî öğretim üyesi eksiklikleri de bulunmakta, bu fakülteleri kazanan öğrenciler kimi zaman taşıma eğitim ile başka şehirlerdeki fakültelerde eğitim görmektedirler. Bu arada, hukuk eğitiminde klasik yöntem olan salt takrir sistemi ile eğitimden vazgeçilerek pratiği de kapsayan, hatta teoriden çok pratiğe eğilerek öğrenciye bir bilgiyi ezberletmek yerine fikir üretme, muhakeme yapma, uyuşmazlık üzerine yaratıcı düşünme teknikleri öğretilmelidir. Pratik ders olarak ifade bulan uygulama çalışmalarında varsayıma dayalı, masa başında üretilmiş senaryolardan uzaklaşılarak, gerçek hukukî uyuşmazlıklar üzerine çözüm üretme yeteneğini geliştirecek bir öğretme tekniği benimsenmelidir. Hiç şüphesiz, bu da hukuk kliniğinin bir kurum ve yöntem olarak hukuk eğitiminde tüm hukuk fakülteleri bünyesinde hayata geçirilmesiyle gerçekleşecektir.</div> \\\n                                        <div class=\"tab-pane\" id=\"summary_other\">The education of law, if the law is an art of favor and justice and it is impossible that making mention to law in a legal system which does not aim that taking place of justice ideally among people is required, should be tackled again on the basis of a belief that lawyers returning law to self, namely to justice and favor, is needed. Particularly, considering recent changes and innovations occurring in the field of law education, it should be stated that making a radical and rooted reform in the field of law education is imperative. At this point, increasing of law faculties’ quotas and the establishment of new law faculties in the body of nearly all universities are not right decisions. Quota increase and decreasing of base point in student admissions come to mean, relatively, admission of students that do not have sufficient fund of knowledge for law education. There is also a serious lack of faculty members in law faculties recently establishedwith inadequacy of physical substructure. Moreover, students getting accepted into these law faculties sometimes receive education in other cities through mobile education. In the meantime, techniques of creative thinking, reasoning, producing ideas in law education should be taught to students instead of having students memorize an information by dispensing with the education with declaration method which is a time-honored practice and perhaps by giving some thought to practice rather than theory.  In these practice studies stated as “practice lessons”, a teaching method that can advance generating solutions techniques over real legal disputes should be adopted by deserting scenarios that is based upon assumptions and produced at a desk. Undoubtedly, this will become fact by means of actualization of legal clinic in the body of all law faculties as an institution and method.</div> \\\n                                        </div> \\\n               </div>');\n            \n            $('<div class=\"tabbable summary_keywords_pane\"> \\\n                <ul class=\"nav nav-tabs\" id=\"myTabs2\">  \\\n                    <li class=\"active\"><a href=\"#keywords_tr\" data-toggle=\"tab\">Anahtar Kelimeler</a></li> \\\n                                    <li> \\\n                    <a href=\"#keywords_other\" data-toggle=\"tab\"> \\\n                Keywords \\\n                </a> \\\n            </li> \\\n                </ul> \\\n                <div class=\"tab-content\"> \\\n                    <div class=\"tab-pane active\" id=\"keywords_tr\"> \\\n                     \\\n                        Hukuk Kliniği ,  \\\n                     \\\n                         Hukuk eğitimi,  \\\n                     \\\n                         Hukuk Eğitiminde Pratiğin Önemi,  \\\n                     \\\n                         Hukukta Meslekî Eğitim,  \\\n                     \\\n                         Profesyonel Hukuk Eğitimi \\\n                     \\\n                    </div> \\\n                                    <div class=\"tab-pane\" id=\"keywords_other\"> \\\n \\\n                         Law Education,  \\\n                     \\\n                        Legal Clinic,  \\\n                     \\\n                         Importance of Practice in Education of Law,  \\\n                     \\\n                         Occupational Education in Law,  \\\n                     \\\n                         Professional Law Education \\\n                     \\\n                    </div> \\\n                                    </div> \\\n               </div>').insertAfter('div.tabbable');\n\n            $('<hr>').insertAfter($('.tabbable'));\n\n            $('.footnote').first().before($('<h1>').text(\"Dipnotlar\"));\n\n\n//            $('#toggleArticleTOC').on('click', function(e) {\n//                e.preventDefault();\n//                $('#articleTOC').toggle();\n//            });\n\n      \n        });\n    </script>\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/vue/1.0.28/vue.min.js\"></script>\n    <script src=\"/js/m38917a2d2ac50.js?1771771227\"></script>\n    <script src=\"/js/typeahead.bundle.js\"></script>\n    <script src=\"/assets/js/plugins/jquery-select/jquery.nice-select.min.js\"></script>\n    <script>\n        $(document).ready(function() {\n            $('footer, .footer-membership').css('display', 'block');\n\n            $('#searchOptions').niceSelect();\n            $('#searchOptionsMobile').niceSelect();\n\n            $('.searchMenuButton').on('click', function() {\n                if ($('.mobileSearch').hasClass('searchShown')) {\n                    $('.mobileSearch').removeClass('searchShown');\n                    $('.slider').removeClass('no-margin');\n                } else {\n                    $('.mobileSearch').addClass('searchShown');\n                    $('.slider').addClass('no-margin');\n                }\n            });\n\n            var scopes = {\n                tasAuthor: {\n                    trName: 'Yazar',\n                    displayField: 'person_full_name',\n                    idField: 'person_idx',\n                    link: '/donsearch?author[]='\n                },\n                tasTitle: {\n                    trName: 'Makale',\n                    displayField: 'title',\n                    idField: 'id',\n                    link: '/article/'\n                },\n                tasKeyword: {\n                    trName: 'Anahtar Kelime',\n                    displayField: 'keyword',\n                    idField: 'id',\n                    link: '/donsearch?'\n                }\n            };\n\n\n            function getBloodHound(displayField, searchScope) {\n                return new Bloodhound({\n                    datumTokenizer: Bloodhound.tokenizers.obj.whitespace(displayField, 'asc'),\n                    queryTokenizer: Bloodhound.tokenizers.whitespace,\n                    remote: {\n                        url: '/tasearch/' + searchScope + '?q=%QUERY',\n                        wildcard: '%QUERY'\n                    }\n                });\n            }\n\n            function getScopeName(scope) {\n                var firstLetter = scope.substr(0, 1);\n                return firstLetter.toUpperCase() + scope.substr(1);\n            }\n\n            var selectedSearchOption = $('#searchOptions').val();\n            if (selectedSearchOption != 'all') {\n                $('#searchOptions').change();\n            }\n\n            $('#searchOptions').on('change', function() {\n\n                $('#searchForm input[name=scope]').remove();\n\n                $('#custom-search-input .input-group input').typeahead('destroy');\n\n                var searchScope = $(this).val();\n\n                if (searchScope != 'all' && searchScope != 'content') {\n\n                    var currentScope = scopes['tas' + getScopeName(searchScope)];\n                    scopes['tas' + getScopeName(searchScope)].func = getBloodHound(scopes['tas' +\n                        getScopeName(searchScope)].displayField, searchScope);\n\n                    $('#custom-search-input .input-group input').typeahead({\n                        hint: false,\n                        highlight: true,\n                        minLength: 3\n                    }, {\n                        classNames: {\n                            input: 'main-search'\n                        },\n                        limit: 100,\n                        display: currentScope.displayField,\n                        source: currentScope.func.ttAdapter(),\n                        templates: {\n                            empty: [\n                                '<div class=\"list-group search-results-dropdown\"><div class=\"list-group-item\">' +\n                                currentScope.trName + ' bulunamadı.</div></div>'\n                            ],\n                            header: [\n                                '<div class=\"list-group search-results-dropdown\">'\n                            ],\n                            suggestion: function(data) {\n                                var sscopeAppend;\n                                var customLink = '';\n                                if (searchScope == 'author' || searchScope == 'keyword') {\n                                    if (searchScope == 'keyword') {\n                                        sscopeAppend = '&sscope=' + searchScope;\n                                        customLink += data.lang + '[]=';\n                                        return '<a href=\"' + currentScope.link +\n                                            customLink + data.id + sscopeAppend +\n                                            '\" class=\"list-group-item\">' + data[currentScope\n                                                .displayField] + '</a>';\n                                    } else {\n                                        sscopeAppend = '&sscope=' + searchScope;\n                                        return '<a href=\"' + currentScope.link +\n                                            customLink + data[currentScope.idField] +\n                                            sscopeAppend + '\" class=\"list-group-item\">' +\n                                            data[currentScope.displayField] + '</a>';\n                                    }\n                                } else {\n                                    sscopeAppend = '?sscope=' + searchScope;\n                                    return '<a href=\"' + currentScope.link + customLink +\n                                        data[currentScope.idField] + sscopeAppend +\n                                        '\" class=\"list-group-item\">' + data[currentScope\n                                            .displayField] + '</a>';\n                                }\n                            }\n                        }\n                    });\n                }\n            });\n        });\n\n    </script>\n\n<script defer src=\"https://static.cloudflareinsights.com/beacon.min.js/vcd15cbe7772f49c399c6a5babf22c1241717689176015\" integrity=\"sha512-ZpsOmlRQV6y907TI0dKBHq9Md29nnaEIPlkf84rnaERnq6zvWvPUqr2ft8M1aS28oN72PdrCzSjY4U6VaAw1EQ==\" data-cf-beacon='{\"version\":\"2024.11.0\",\"token\":\"6d54b8e9829c45fb9aef2c43c8e92a93\",\"server_timing\":{\"name\":{\"cfCacheStatus\":true,\"cfEdge\":true,\"cfExtPri\":true,\"cfL4\":true,\"cfOrigin\":true,\"cfSpeedBrain\":true},\"location_startswith\":null}}' crossorigin=\"anonymous\"></script>\n</body>\n\n</html>\n"
